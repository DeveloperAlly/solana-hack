// Cloudflare Worker that serves the built SPA (ADR-005) and answers /api/* from worker/index.ts.
// Docs: https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
//       https://developers.cloudflare.com/workers/static-assets/binding/#run_worker_first
//       https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waterlily",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  // @solana/kit resolves to its Node build in workerd (backend map G-SAS), so Node APIs are needed.
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs, so console output (registry and API errors) can be read after the fact.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; every other path is served from assets as before.
    "run_worker_first": ["/api/*"]
  },
  // Secrets REGISTRAR_KEY, RPC_URL and SELFTEST_TOKEN are set by the deploy workflow with
  // `wrangler deploy --secrets-file` (never committed).
  // Owner decision 2026-10-06, recorded at https://github.com/DeveloperAlly/solana-hack/issues/4#issuecomment-6014295120 :
  // the app runs on the apex of jamjam.tech. Deploying creates the DNS record and certificate.
  "routes": [{ "pattern": "jamjam.tech", "custom_domain": true }],
  // Per-IP abuse limit for the anonymous endpoints (/api/verify, /api/ledger), which query the database and Solana.
  // Workers rate limiting binding; namespace_id is an account-unique number we choose; period must be 10 or 60.
  // 6 per minute matches the spec's 30 verifications per five minutes (spec/api/routes/brand_builder.ts).
  "ratelimits": [{ "name": "PUBLIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }]
}

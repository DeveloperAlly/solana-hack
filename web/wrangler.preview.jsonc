// Preview Worker for the new UI flow (issue #45, "Where it lives"; issue #46, "Preview deploy"). Deployed from
// ui/integration by .github/workflows/web-preview.yml with `wrangler deploy --config wrangler.preview.jsonc`.
// It serves the same build as the live Worker, at its workers.dev URL only. The live Worker (wrangler.jsonc,
// name "waterlily", custom domain jamjam.tech) is untouched: a different name is a different Worker.
// Docs (checked 2026-10-12):
//   https://developers.cloudflare.com/workers/wrangler/configuration/  (workers_dev: "Enables use of *.workers.dev
//     subdomain to deploy your Worker"; defaults to true only when there are no routes; set explicitly here)
//   https://developers.cloudflare.com/workers/configuration/routing/workers-dev/  (URL format
//     <YOUR_WORKER_NAME>.<YOUR_SUBDOMAIN>.workers.dev)
//   https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/  (SPA fallback, so a
//     deep link such as /screens/Verify-2-NoMatch serves index.html and the router renders it)
//   --config / -c: "Path to Wrangler configuration file" (`npx wrangler deploy --help`, wrangler 4.147)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jamjam-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  // Same as the live Worker: @solana/kit resolves to its Node build in workerd (backend map G-SAS).
  "compatibility_flags": ["nodejs_compat"],
  // Same as the live Worker: our allowlisted console output only, no per-request URL logs.
  // Source: https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // workers.dev only. No routes, no custom domain, no rate-limit binding, no secrets: the gallery makes no API
  // calls, and without secrets the Worker cannot reach Supabase, OpenRouter or the Registrar key.
  "workers_dev": true
}
